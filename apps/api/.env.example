# Copy to .env. Every value below has a development default except where noted.

NODE_ENV=development
PORT=4000

# Postgres with PostGIS. `./scripts/dev-db.ps1 start` (portable) listens on 5433;
# `docker compose up -d db` listens on 5432.
DATABASE_URL=postgres://raha:raha_dev@localhost:5433/raha

# REQUIRED in production (the API refuses to boot with the dev defaults when NODE_ENV=production).
JWT_SECRET=dev-only-jwt-secret-change-me
# 32 bytes, base64. Encrypts delivery PINs at rest so support can re-send them.
PIN_ENC_KEY=ZGV2LW9ubHktcGluLWtleS0zMi1ieXRlcy1sb25nISE=
# Signs short-lived file URLs for proof photos and verification documents.
FILE_SIGNING_SECRET=dev-only-file-signing-secret

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Where uploaded photos/documents are stored (local disk driver).
STORAGE_DIR=./storage

# Used to build links in SMS (receiver page) and CORS defaults.
PUBLIC_WEB_URL=http://localhost:3000
# Base URL clients use to reach this API (used in signed file URLs).
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Messaging. `console` logs messages instead of sending (development).
SMS_PROVIDER=console
TELEGRAM_BOT_TOKEN=
# When true, /auth/otp/request echoes the code in the response. Never enable in production.
OTP_DEV_ECHO=true
